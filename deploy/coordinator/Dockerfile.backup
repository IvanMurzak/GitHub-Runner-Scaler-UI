# The coordinator's daily database backup: see backup.sh.
#
# Same account as the coordinator image, to read its database; an empty named
# volume takes its owner from here: /backups always, and /data when a restore
# runs on a volume no coordinator has opened yet.
FROM alpine:3.21
RUN apk add --no-cache sqlite \
    && mkdir /data /backups \
    && chown 10001:10001 /data /backups
COPY deploy/coordinator/backup.sh /usr/local/bin/backup.sh
USER 10001:10001
VOLUME ["/backups"]
ENTRYPOINT ["/bin/sh", "/usr/local/bin/backup.sh"]
