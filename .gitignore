# Rust build output
/target/
**/*.rs.bk
*.pdb

# Cargo.lock is intentionally committed: this workspace ships a binary.

# Local runtime and state produced by the agent during development
/runtime/
/state/
/logs/

# Editors and OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Host-managed worker isolation worktrees (/taskflow-execute --parallel>1).
# These land inside the checkout path; without this entry they surface as
# untracked paths and read as a leaked isolation boundary.
/.claude/worktrees/
